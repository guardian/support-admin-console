{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "lib": ["dom", "es2017", "es2019", "es2020"],
    "jsx": "react",
    "allowJs": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "strict": true,
    "outDir": "./public/build",
    "types": ["jest", "node"]
  },
  "exclude": [
    "node_modules",
    "e2e",
    "target",
    "config",
    "scripts",
    "**/*.spec.tsx",
    "cdk",
    "**/*.bundle.js"
  ]
}
